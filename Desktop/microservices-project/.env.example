# ============================================================
# Environment variables for docker-compose
# Copy to .env and adjust values before running
# ============================================================

# PostgreSQL — Incidents DB (matches your local setup)
INCIDENT_DB_PASSWORD=ABDO0505
USER_DB_PASSWORD=ABDO0505

# PostgreSQL — Comment & Chat services
COMMENT_DB_PASSWORD=postgres
CHAT_DB_PASSWORD=postgres

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Keycloak admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
